{%- assign cupom = 'WELCOME' -%}
{%- assign desconto = '10% OFF' -%}

<style>
  .kz-pop__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 20px;
  }
  .kz-pop__overlay.is-open { display: flex; }

  .kz-pop__box {
    background: #ffffff;
    max-width: 380px;
    width: 100%;
    padding: 32px 24px;
    text-align: center;
    position: relative;
    font-family: 'Poppins', sans-serif;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
  }
  .kz-pop__close {
    position: absolute;
    top: 10px;
    right: 14px;
    background: none;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    color: #5d6361;
    cursor: pointer;
    padding: 4px;
  }
  .kz-pop__title {
    font-size: 1.35rem;
    font-weight: 600;
    color: #5d6361;
    margin: 0 0 10px;
    line-height: 1.3;
  }
  .kz-pop__sub {
    font-size: 0.9rem;
    color: #5d6361;
    opacity: 0.8;
    margin: 0 0 20px;
    line-height: 1.4;
  }
  .kz-pop__btn {
    background: #5d6361;
    color: #ffffff;
    border: none;
    padding: 14px 28px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    width: 100%;
    font-family: 'Poppins', sans-serif;
    transition: opacity 0.2s;
  }
  .kz-pop__btn:hover { opacity: 0.85; }

  .kz-pop__reveal { display: none; }
  .kz-pop__reveal.is-visible { display: block; }

  .kz-pop__code {
    background: #e4e3e8;
    color: #5d6361;
    padding: 14px;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin: 0 0 12px;
    cursor: pointer;
    user-select: all;
  }
  .kz-pop__hint {
    font-size: 0.75rem;
    color: #5d6361;
    opacity: 0.7;
    margin: 0;
  }
  .kz-pop__frete {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid #e4e3e8;
    font-size: 0.78rem;
    color: #5d6361;
    opacity: 0.85;
  }
</style>

<div class="kz-pop__overlay" id="kzPop">
  <div class="kz-pop__box">
    <button class="kz-pop__close" aria-label="Fechar">&times;</button>

    <div class="kz-pop__step1">
      <p class="kz-pop__title">Você ganhou {{ desconto }} na sua primeira compra!</p>
      <p class="kz-pop__sub">Aproveite agora e garanta seu desconto.</p>
      <button class="kz-pop__btn" id="kzPopReveal">Resgatar agora</button>
    </div>

    <div class="kz-pop__reveal" id="kzPopCode">
      <p class="kz-pop__title">Seu cupom está pronto</p>
      <p class="kz-pop__code">{{ cupom }}</p>
      <p class="kz-pop__hint">Toque no código para copiar e use no checkout.</p>
      <button class="kz-pop__btn" id="kzPopShop" style="margin-top:16px;">Continuar comprando</button>
    </div>

    <p class="kz-pop__frete">Frete grátis nas compras acima de R$ 599,90</p>
  </div>
</div>

<script>
  (function () {
    var pop = document.getElementById('kzPop');
    if (!pop) { return; }

    var KEY = 'kazy_pop_visto';

    // só mostra no primeiro acesso
    try {
      if (localStorage.getItem(KEY)) { return; }
    } catch (e) {}

    function marcarVisto() {
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    }

    function fechar() {
      pop.classList.remove('is-open');
      marcarVisto();
    }

    // abre depois de 2 segundos
    setTimeout(function () { pop.classList.add('is-open'); }, 7000);

    pop.querySelector('.kz-pop__close').addEventListener('click', fechar);

    pop.addEventListener('click', function (e) {
      if (e.target === pop) { fechar(); }
    });

    document.getElementById('kzPopReveal').addEventListener('click', function () {
      pop.querySelector('.kz-pop__step1').style.display = 'none';
      document.getElementById('kzPopCode').classList.add('is-visible');
      marcarVisto();
    });

    document.getElementById('kzPopShop').addEventListener('click', fechar);

    var code = pop.querySelector('.kz-pop__code');
    code.addEventListener('click', function () {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(code.textContent.trim());
        var hint = pop.querySelector('.kz-pop__hint');
        hint.textContent = 'Código copiado!';
      }
    });
  })();
</script>