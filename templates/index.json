        "liquid": "<style>\n  .beneficios-custom .beneficios__wrap {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 24px;\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n  .beneficios-custom .beneficio {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    flex: 1 1 220px;\n    max-width: 260px;\n    text-align: left;\n  }\n  .beneficios-custom .beneficio__icon {\n    width: 40px;\n    height: 40px;\n    object-fit: contain;\n    flex-shrink: 0;\n  }\n  .beneficios-custom .beneficio__title {\n    font-weight: 600;\n    font-size: 0.85rem;\n    line-height: 1.2;\n    margin: 0;\n    text-transform: uppercase;\n    letter-spacing: 0.02em;\n  }\n  .beneficios-custom .beneficio__text {\n    font-size: 0.78rem;\n    line-height: 1.2;\n    margin: 3px 0 0;\n    opacity: 0.75;\n  }\n\n  /* MOBILE: vira carrossel deslizável */\n  @media (max-width: 749px) {\n    .beneficios-custom .beneficios__wrap {\n      flex-wrap: nowrap;               /* não quebra mais linha */\n      overflow-x: auto;                /* permite arrastar pro lado */\n      scroll-snap-type: x mandatory;   /* encaixa cada item no lugar */\n      -webkit-overflow-scrolling: touch;\n      gap: 12px;\n      padding-bottom: 8px;\n      justify-content: flex-start;\n      scrollbar-width: none;           /* esconde a barrinha no Firefox */\n    }\n    .beneficios-custom .beneficios__wrap::-webkit-scrollbar {\n      display: none;                   /* esconde a barrinha no Chrome/Safari */\n    }\n    .beneficios-custom .beneficio {\n      flex: 0 0 80%;                   /* cada card ocupa 80% da tela */\n      max-width: 80%;\n      scroll-snap-align: center;       /* encaixa centralizado */\n    }\n  }\n</style>\n\n<div class=\"beneficios-custom\">\n  <div class=\"beneficios__wrap\">\n    <div class=\"beneficio\">\n      <img class=\"beneficio__icon\" src=\"COLE_AQUI_URL_ICONE_1\" alt=\"Entregamos para todo o Brasil\">\n      <div class=\"beneficio__content\">\n        <p class=\"beneficio__title\">Entregamos para todo o Brasil</p>\n        <p class=\"beneficio__text\">Envio imediato</p>\n      </div>\n    </div>\n    <div class=\"beneficio\">\n      <img class=\"beneficio__icon\" src=\"COLE_AQUI_URL_ICONE_2\" alt=\"Frete Grátis para todo o Brasil\">\n      <div class=\"beneficio__content\">\n        <p class=\"beneficio__title\">Frete Grátis para todo o Brasil</p>\n        <p class=\"beneficio__text\">Em compras a partir de R$599,90</p>\n      </div>\n    </div>\n    <div class=\"beneficio\">\n      <img class=\"beneficio__icon\" src=\"COLE_AQUI_URL_ICONE_3\" alt=\"Zero Transparência\">\n      <div class=\"beneficio__content\">\n        <p class=\"beneficio__title\">Zero Transparência</p>\n        <p class=\"beneficio__text\">Tecido premium</p>\n      </div>\n    </div>\n    <div class=\"beneficio\">\n      <img class=\"beneficio__icon\" src=\"COLE_AQUI_URL_ICONE_4\" alt=\"Site Confiável\">\n      <div class=\"beneficio__content\">\n        <p class=\"beneficio__title\">Site Confiável</p>\n        <p class=\"beneficio__text\">Compre com segurança</p>\n      </div>\n    </div>\n  </div>\n</div>",
