    "custom_liquid_wTgYdH": {
      "type": "custom-liquid",
      "name": "t:sections.custom_liquid.presets.custom_liquid.name",
      "settings": {
        "separate_section_with_border": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": true,
        "liquid": "<style>\n  .beneficios-custom .beneficios__wrap {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 24px;\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n  .beneficios-custom .beneficio {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    flex: 1 1 220px;\n    max-width: 260px;\n    text-align: left;\n  }\n  .beneficios-custom .beneficio__icon {\n    width: 40px;\n    height: 40px;\n    object-fit: contain;\n    flex-shrink: 0;\n  }\n  .beneficios-custom .beneficio__title {\n    font-weight: 600;\n    font-size: 0.85rem;\n    line-height: 1.2;\n    margin: 0;\n    text-transform: uppercase;\n    letter-spacing: 0.02em;\n  }\n  .beneficios-custom .beneficio__text {\n    font-size: 0.78rem;\n    line-height: 1.2;\n    margin: 3px 0 0;\n    opacity: 0.75;\n  }\n\n  /* bolinhas: escondidas no desktop */\n  .beneficios-custom .beneficios__dots {\n    display: none;\n  }\n\n  /* MOBILE: carrossel deslizável + bolinhas */\n  @media (max-width: 749px) {\n    .beneficios-custom .beneficios__wrap {\n      flex-wrap: nowrap;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n      gap: 12px;\n      padding: 0 10%;                  /* respiro igual nas duas pontas */\n      justify-content: flex-start;\n      scrollbar-width: none;\n    }\n    .beneficios-custom .beneficios__wrap::-webkit-scrollbar {\n      display: none;\n    }\n    .beneficios-custom .beneficio {\n      flex: 0 0 80%;\n      max-width: 80%;\n      scroll-snap-align: center;       /* encaixa sempre no centro */\n      justify-content: center;         /* centraliza o conteúdo dentro do card */\n    }\n\n    .beneficios-custom .beneficios__dots {\n      display: flex;\n      justify-content: center;\n      gap: 8px;\n      margin-top: 12px;\n    }\n    .beneficios-custom .beneficios__dot {\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      border: none;\n      padding: 0;\n      background: #ccc;\n      transition: background 0.2s, transform 0.2s;\n      cursor: pointer;\n    }\n    .beneficios-custom .beneficios__dot.is-active {\n      background: #333;\n      transform: scale(1.3);\n    }\n  }\n</style>\n\n<div class=\"beneficios-custom\">\n  <div class=\"beneficios__wrap\">\n    <div class=\"beneficio\">\n      <img class=\"beneficio__icon\" src=\"https://cdn.shopify.com/s/files/1/0874/1961/7584/files/1_55c92779-65fd-4112-8a91-f50842af1577.png?v=1783542219\" alt=\"Entregamos para todo o Brasil\">\n      <div class=\"beneficio__content\">\n        <p class=\"beneficio__title\">Entregamos para todo o Brasil</p>\n        <p class=\"beneficio__text\">Envio imediato</p>\n      </div>\n    </div>\n    <div class=\"beneficio\">\n      <img class=\"beneficio__icon\" src=\"https://cdn.shopify.com/s/files/1/0874/1961/7584/files/2_ab39d19e-8ec9-4e22-b43d-0d09d7a24332.png?v=1783542219\" alt=\"Frete Grátis para todo o Brasil\">\n      <div class=\"beneficio__content\">\n        <p class=\"beneficio__title\">Frete Grátis para todo o Brasil</p>\n        <p class=\"beneficio__text\">Em compras a partir de R$599,90</p>\n      </div>\n    </div>\n    <div class=\"beneficio\">\n      <img class=\"beneficio__icon\" src=\"https://cdn.shopify.com/s/files/1/0874/1961/7584/files/3_4cbee601-73fb-4cdb-8865-6385ad00aee2.png?v=1783542688\" alt=\"Zero Transparência\">\n      <div class=\"beneficio__content\">\n        <p class=\"beneficio__title\">Zero Transparência</p>\n        <p class=\"beneficio__text\">Tecido premium</p>\n      </div>\n    </div>\n    <div class=\"beneficio\">\n      <img class=\"beneficio__icon\" src=\"https://cdn.shopify.com/s/files/1/0874/1961/7584/files/4_ea53f042-febb-47a3-a385-86ff2ca59a10.png?v=1783542689\" alt=\"Compra Segura\">\n      <div class=\"beneficio__content\">\n        <p class=\"beneficio__title\">Site Confiável</p>\n        <p class=\"beneficio__text\">Compre com segurança</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"beneficios__dots\"></div>\n</div>\n\n<script>\n  (function () {\n    var root = document.currentScript.previousElementSibling;\n    if (!root || !root.classList.contains('beneficios-custom')) { return; }\n\n    var wrap = root.querySelector('.beneficios__wrap');\n    var dotsBox = root.querySelector('.beneficios__dots');\n    var cards = root.querySelectorAll('.beneficio');\n    if (!wrap || !dotsBox || !cards.length) { return; }\n\n    var dots = [];\n    for (var i = 0; i < cards.length; i++) {\n      var dot = document.createElement('button');\n      dot.className = 'beneficios__dot';\n      dot.setAttribute('aria-label', 'Ir para o benefício ' + (i + 1));\n      (function (index) {\n        dot.addEventListener('click', function () {\n          cards[index].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });\n        });\n      })(i);\n      dotsBox.appendChild(dot);\n      dots.push(dot);\n    }\n\n    function updateActive() {\n      var center = wrap.scrollLeft + wrap.clientWidth / 2;\n      var closest = 0;\n      var closestDist = Infinity;\n      for (var i = 0; i < cards.length; i++) {\n        var cardCenter = cards[i].offsetLeft + cards[i].offsetWidth / 2;\n        var dist = Math.abs(cardCenter - center);\n        if (dist < closestDist) { closestDist = dist; closest = i; }\n      }\n      for (var j = 0; j < dots.length; j++) {\n        dots[j].classList.toggle('is-active', j === closest);\n      }\n    }\n\n    var ticking = false;\n    wrap.addEventListener('scroll', function () {\n      if (!ticking) {\n        window.requestAnimationFrame(function () { updateActive(); ticking = false; });\n        ticking = true;\n      }\n    });\n\n    updateActive();\n  })();\n</script>",
        "text_alignment": "center"
      }
    },
