        "liquid": "{%- assign meta_frete = 59990 -%}\n{%- comment -%} valor do frete grátis em centavos. 59990 = R$ 599,90. TROQUE aqui pelo valor REAL da Yampi. {%- endcomment -%}\n\n<style>\n  .frete-bar {\n    max-width: 600px;\n    margin: 0 auto 16px;\n    padding: 14px 16px;\n    font-size: 1rem;\n    text-align: center;\n  }\n  .frete-bar__msg {\n    margin: 0 0 10px;\n    line-height: 1.3;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n  }\n  .frete-bar__icon {\n    width: 38px;\n    height: 38px;\n    object-fit: contain;\n    flex-shrink: 0;\n  }\n  .frete-bar__msg strong { font-weight: 700; }\n  .frete-bar__track {\n    width: 100%;\n    height: 10px;\n    background: #e6e6e6;\n    border-radius: 20px;\n    overflow: hidden;\n  }\n  .frete-bar__fill {\n    height: 100%;\n    width: 0;\n    background: #AE002D;\n    border-radius: 20px;\n    transition: width 0.4s ease;\n  }\n  .frete-bar.is-complete .frete-bar__fill { background: #1a7f37; }\n\n  /* MOBILE: um pouco maior ainda */\n  @media (max-width: 749px) {\n    .frete-bar { font-size: 1.05rem; }\n    .frete-bar__icon { width: 44px; height: 44px; }\n    .frete-bar__track { height: 12px; }\n  }\n</style>\n\n<div class=\"frete-bar\" data-meta=\"{{ meta_frete }}\">\n  <p class=\"frete-bar__msg\">\n    <img class=\"frete-bar__icon\"\n         src=\"https://cdn.shopify.com/s/files/1/0874/1961/7584/files/1_55c92779-65fd-4112-8a91-f50842af1577.png?v=1783542219\"\n         alt=\"Frete\">\n    <span class=\"frete-bar__text\"></span>\n  </p>\n  <div class=\"frete-bar__track\">\n    <div class=\"frete-bar__fill\"></div>\n  </div>\n</div>\n\n<script>\n  (function () {\n    var box = document.currentScript.previousElementSibling;\n    if (!box || !box.classList.contains('frete-bar')) { return; }\n\n    var META = parseInt(box.getAttribute('data-meta'), 10) || 0;\n    var text = box.querySelector('.frete-bar__text');\n    var fill = box.querySelector('.frete-bar__fill');\n\n    function fmt(cents) {\n      return 'R$ ' + (cents / 100).toFixed(2).replace('.', ',');\n    }\n\n    function render(total) {\n      var falta = META - total;\n      var pct = Math.min(100, Math.round((total / META) * 100));\n      fill.style.width = pct + '%';\n\n      if (falta <= 0) {\n        box.classList.add('is-complete');\n        text.innerHTML = 'Você ganhou <strong>frete grátis</strong>!';\n      } else {\n        box.classList.remove('is-complete');\n        text.innerHTML = 'Faltam <strong>' + fmt(falta) + '</strong> para o frete grátis';\n      }\n    }\n\n    function refresh() {\n      fetch('/cart.js', { headers: { 'Content-Type': 'application/json' } })\n        .then(function (r) { return r.json(); })\n        .then(function (c) { render(c.total_price); })\n        .catch(function () {});\n    }\n\n    var _fetch = window.fetch;\n    window.fetch = function () {\n      var url = (arguments[0] && arguments[0].url) || arguments[0] || '';\n      return _fetch.apply(this, arguments).then(function (res) {\n        if (typeof url === 'string' && url.indexOf('/cart') > -1) {\n          setTimeout(refresh, 300);\n        }\n        return res;\n      });\n    };\n\n    refresh();\n  })();\n</script>",
